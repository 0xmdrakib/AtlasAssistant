{
  "name": "atlas-assistant",
  "version": "1.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:billing": "tsx --test tests/payment-providers.test.ts tests/checkout-client.test.ts",
    "test:database-runtime": "tsx --test tests/database-runtime.test.ts",
    "test:checkout": "tsx --test tests/checkout.test.ts",
    "test:checkout-ui": "node tests/checkout-interactions.mjs",
    "test:speech": "tsx --test tests/speech-player.test.ts",
    "test:speech-ui": "node tests/speech-interactions.mjs",
    "test:saved": "tsx --test tests/saved-items.test.ts",
    "test:saved-ui-state": "tsx --test tests/saved-state.test.ts",
    "test:saved-interactions": "node tests/saved-interactions.mjs",
    "test:feed": "tsx --test tests/feed.test.ts",
    "test:feed-interactions": "node tests/feed-interactions.mjs",
    "db:migrate:saved": "prisma db execute --file prisma/changes/20260909_saved_items.sql --schema prisma/schema.prisma",
    "db:migrate:checkout": "prisma db execute --file prisma/changes/20260909_embedded_checkout.sql --schema prisma/schema.prisma",
    "db:migrate:feed": "prisma db execute --file prisma/changes/20260909_feed_performance.sql --schema prisma/schema.prisma && prisma db execute --file prisma/changes/20260909_retire_faith.sql --schema prisma/schema.prisma",
    "db:migrate": "prisma db push --skip-generate",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.mjs",
    "sources:sync": "tsx scripts/sync-sources.ts",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:loop": "tsx scripts/ingest-loop.ts",
    "setup": "npm run db:migrate && npm run db:seed && npm run sources:sync && npm run ingest",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.19.1",
    "@upstash/qstash": "^2.8.4",
    "fast-xml-parser": "^4.5.0",
    "lucide-react": "^0.542.0",
    "next": "^14.2.5",
    "next-auth": "^4.24.11",
    "next-themes": "^0.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.39",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
